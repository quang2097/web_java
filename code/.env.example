# Copy this file to .env in the project root for local development.
# These credentials and the JWT secret are development defaults; change before deployment.
# Existing environment variables take priority over .env.
# Website admin: process environment > .env > saved launcher settings.
# The launcher retains its saved database credentials and JWT secret.

# PostgreSQL: matches compose.yaml and the local Docker password reset.
# Changing this value does not reset the password in an existing database volume.
DB_URL=jdbc:postgresql://localhost:5432/supermarket
DB_USER=supermarket
DB_PASSWORD=supermarket123

# Initial website administrator (created only if this username does not exist).
# This does not change the password of an existing website account.
# To intentionally apply this password to an existing ADMIN, stop the website
# and run Reset-Admin-Password.cmd once, then use Start-Supermarket.cmd normally.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=supermarket123

# Set a Base64-encoded random key of at least 32 bytes for direct Java launches.
# When empty, a random process-local key is generated. The Windows launcher
# uses its saved encrypted key instead.
JWT_SECRET=

# VietQR payment details: replace with your receiving bank account.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Explicitly opt in to sample products, inventory and historical sales.
# Keep false for operational databases. This does not remove existing data.
APP_DEMO_ENABLED=false

# Gemini: leave the API key empty to use the built-in local analytics fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
